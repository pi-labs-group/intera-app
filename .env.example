# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione o .env.local.

# --- Supabase (preenchidas na fase de dados/auth) ---
# URL do projeto Supabase (exposta ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" do Supabase (exposta ao navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service role" do Supabase — SOMENTE no servidor, nunca exponha ao cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados / Prisma (preenchidas na fase de dados/auth) ---
# String de conexão via pooler (usada pela aplicação em runtime)
DATABASE_URL=
# String de conexão direta (usada pelo Prisma em migrations)
DIRECT_URL=
