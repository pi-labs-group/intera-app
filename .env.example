# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione o .env.local.

# --- Supabase (preenchidas na fase de dados/auth) ---
# URL do projeto Supabase (exposta ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" do Supabase (exposta ao navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service role" do Supabase — SOMENTE no servidor, nunca exponha ao cliente
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados / Prisma ---
# Banco do Supabase: painel do projeto > Connect > ORMs > Prisma.
# Transaction pooler (porta 6543), usada pela aplicação em runtime
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (porta 5432), usada pelo Prisma em migrations.
# Não use a "Direct connection": ela só funciona em redes IPv6.
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
